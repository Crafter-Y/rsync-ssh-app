{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "constraints": {
    "npm": "^12.0.0"
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "groupName": "all dependencies",
      "matchPackageNames": [
        "*"
      ],
      "separateMajorMinor": false,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
